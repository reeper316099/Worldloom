{
  "name": "@worldloom/desktop",
  "productName": "Worldloom",
  "version": "0.1.0",
  "description": "Local-first wiki builder for deep fictional lore",
  "private": true,
  "main": "dist/desktop.cjs",
  "author": {
    "name": "Worldloom contributors",
    "email": "worldloom@users.noreply.github.com"
  },
  "license": "MIT",
  "scripts": {
    "build": "node ../../scripts/build-desktop.mjs",
    "start": "npm run build && electron .",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "dev.worldloom.app",
    "productName": "Worldloom",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Worldloom contributors <worldloom@users.noreply.github.com>",
      "executableName": "worldloom"
    },
    "electronVersion": "34.5.8",
    "artifactName": "Worldloom-${version}-${os}-${arch}.${ext}",
    "afterPack": "../../scripts/adhoc-sign.cjs"
  },
  "devDependencies": {
    "electron": "34.5.8",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0"
  },
  "homepage": "https://github.com/reeper316099/Worldloom"
}
