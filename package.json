{
  "name": "worldloom",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p apps/web/tsconfig.json",
    "test": "vitest run --exclude \"**/perf.test.ts\" && vitest run packages/server/test/perf.test.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "dev": "node scripts/dev.mjs",
    "e2e": "node scripts/build-desktop.mjs && playwright test",
    "build:desktop": "node scripts/build-desktop.mjs",
    "start": "npm run start -w @worldloom/desktop",
    "dist": "npm run dist -w @worldloom/desktop",
    "test:perf": "vitest run packages/server/test/perf.test.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "fast-check": "^3.23.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
